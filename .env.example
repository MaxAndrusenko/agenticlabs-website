# Replace re_xxxxxxxxx with your real Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=hello@agenticlabs.cloud

# Sender address. Use onboarding@resend.dev for testing;
# switch to an address on your verified domain for production.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Google reCAPTCHA v2 ("I'm not a robot"). Create keys at https://www.google.com/recaptcha/admin
# Register domains: localhost (local) and your live domain. Paste keys below.
# Avoid Google's public test keys — they always show a "testing purposes only" banner.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Contact abuse controls (per IP, in-memory)
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=3600000

# Port for the Express API (Nginx proxies /api/ here in production)
PORT=3000
